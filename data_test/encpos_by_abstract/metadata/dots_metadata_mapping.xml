<?xml version="1.0" encoding="UTF-8"?>
<metadataMap xmlns="https://github.com/dots-suite/dots"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:html="http://www.w3.org/1999/xhtml">
  <mapping>
    <!-- collections -->
    <dct:title  scope="collection" format="tsv" source="./default_collections_titles.tsv" value="title"/>
    <!-- documents -->
    <dct:license scope="document" resourceId="all" value=".">https://creativecommons.org/licenses/by-nc-sa/4.0/</dct:license>
    <dct:title scope="document" xpath="//titleStmt/title[@type = 'main' or position() = 1]"/>
    <html:h1 scope="document" format="tsv" source="./documents_metadata.tsv" value="title_rich"/>
    <dct:date  scope="document" format="tsv" source="./documents_metadata.tsv" value="promotion_year" type="number"/>
    <dct:creator scope="document" format="tsv" source="./documents_metadata.tsv" value="author_fullname_label"/>
    <dct:creator scope="document" format="tsv" source="./documents_metadata.tsv" value="author_idref_ppn" prefix="https://www.idref.fr/" key="@id"/>
    <dct:creator scope="document" format="tsv" source="./documents_metadata.tsv" value="author_bnf_ark" prefix="https://data.bnf.fr/" key="@id"/>
    <dct:extent scope="document" format="tsv" source="./documents_metadata.tsv" value="pagination"/>
  </mapping>
</metadataMap>